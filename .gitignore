# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
ENV/
env/

# Local configuration and secrets
.env
.env.*
!.env.example

# Test and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local logs
logs/
*.log

# Downloaded, processed, and rejected data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/rejected/*
!data/rejected/.gitkeep

# Local database and temporary files
*.sqlite
*.sqlite3
*.db
*.tmp
